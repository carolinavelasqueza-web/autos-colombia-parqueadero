# Ejemplos: completa backend/.env con tus datos locales. No publiques ese archivo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=CAMBIAR_BASE_DE_DATOS
DB_USER=CAMBIAR_USUARIO
DB_PASSWORD=CAMBIAR_PASSWORD
DB_CONNECT_TIMEOUT=5
# 1 siembra las 80 celdas base al iniciar; 0 desactiva el seed automático.
CELDAS_SEED_ON_STARTUP=1
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_GENERA_UNA_CLAVE_ALEATORIA_DE_32_BYTES
JWT_EXPIRE_MINUTES=60
